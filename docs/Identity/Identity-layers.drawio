  <diagram name="Page-1" id="afM5BFzj8vQnAnrP-5j8">
    <mxGraphModel dx="2357" dy="1407" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;                                                                                                                                                                                                                                        \n    sequenceDiagram                                                                                                                                                                                                                        \n        autonumber                                                                                                                                                                                                                         \n        actor User as Student / Teacher                                                                                                                                                                                                    \n        participant Client as Frontend (Web / Mobile)                                                                                                                                                                                      \n        participant L1 as Layer 1: Global Identity (Clerk / Supabase)                                                                                                                                                                      \n        participant API as AlphaZero API (.NET 10)                                                                                                                                                                                         \n        participant DB as AlphaZero DB (Identity Module)                                                                                                                                                                                   \n                                                                                                                                                                                                                                           \n        %% Layer 1                                                                                                                                                                                                                         \n        Note over User,L1: Layer 1 — Global Identity (Person)                                                                                                                                                                              \n        User-&gt;&gt;Client: Clicks \&quot;Sign in with Google\&quot; / Email OTP                                                                                                                                                                            \n        Client-&gt;&gt;L1: Authenticate via SDK / Pre-built UI                                                                                                                                                                                   \n        L1--&gt;&gt;Client: Global JWT (Contains `sub` = IdentityId, email, name)                                                                                                                                                                \n                                                                                                                                                                                                                                           \n        %% Layer 2                                                                                                                                                                                                                         \n        Note over Client,DB: Layer 2 — Tenant Token Exchange                                                                                                                                                                               \n        Client-&gt;&gt;API: POST /identity/auth/exchange-tenant-token&lt;br/&gt;(Header: Bearer Global_JWT, Body: TenantId, PublicKey, DeviceName)                                                                                                     \n        API-&gt;&gt;API: Validate Global JWT (via standard JWKS/OIDC)                                                                                                                                                                            \n        API-&gt;&gt;DB: Find or JIT-Create TenantUser &amp; Register Device                                                                                                                                                                          \n        API--&gt;&gt;Client: AlphaZero Scoped JWT (TenantUserId, TenantId, DeviceId)\n  \n        %% Layer 3\n        Note over Client,DB: Layer 3 — Contextual / Resource Evaluation (or Principal Login)\n        Client-&gt;&gt;API: Request Course Resource (Bearer Scoped_JWT)\n        API-&gt;&gt;DB: Fetch Effective Policies (TenantUserPrincipalAssignments)\n        API-&gt;&gt;API: ABAC/PBAC Policy Engine Evaluates (Implicit Deny)\n        API--&gt;&gt;Client: 200 OK / 403 Forbidden&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BsZRVwkknjORYZrrqA9W-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
